# syntax=docker/dockerfile:1.7
# ==============================================================================
# Dockerfile for Qwen3.5-122B-A10B SFT via megatron-bridge
# ------------------------------------------------------------------------------
# Base: NGC PyTorch 25.06-py3
#   CUDA 12.9.1 / PyTorch 2.8.0a0+nv25.06 / cuDNN 9.10.2 / TE 2.4 / NCCL /
#   APEX (with cuda ext) / flash-attn 2.7.4 — ALL inherited verbatim.
#
# What this image contains:
#   - OS tools (git, tmux, curl, …) + timezone set to Asia/Shanghai (UTC+8)
#   - uv (package manager)
#   - /opt/venv-mbridge: a venv that inherits NGC site-packages, plus:
#       causal-conv1d 1.6.1 + mamba-ssm 2.3.1 (prebuilt wheels, ABI-patched)
#       flash-linear-attention 0.4.2 + fla-core 0.4.2 (pure Python, network install)
#       ALL stable pure-Python deps from docker/requirements-prebaked.txt:
#         transformers, peft, datasets, accelerate, diffusers, omegaconf,
#         tensorboard, wandb, hydra-core, timm, open-clip-torch, mlflow,
#         comet-ml, nvidia-resiliency-ext, pytest, ruff, mypy, pre-commit, …
#   - mamba_ssm/__init__.py ABI patch (makes import non-fatal on NGC torch 2.8a)
#
# Runtime `uv sync` only needs to install megatron-core + megatron-bridge (~1 min
# vs ~10 min on images without prebaked deps).
#
# What this image does NOT contain:
#   - Megatron-Bridge source code  ← lives on NAS, mounted at runtime
#   - megatron-core (Megatron-LM)  ← installed at runtime via `uv sync`
#   - megatron-bridge editable install  ← done at runtime via `uv pip install -e`
#
# Design principle:
#   Pure *environment* image. All business logic lives on the NAS under /mnt.
#   Operator runs `bash scripts/install_runtime_deps.sh` once per container
#   to install megatron-core + megatron-bridge, then starts training.
#   Image rebuild is only needed when system packages or wheels change.
#
# Build:
#   # 1) Download prebuilt wheels (~780 MB) into docker/runtime_wheels/
#   mkdir -p docker/runtime_wheels && cd docker/runtime_wheels
#   curl -fL -o causal_conv1d-1.6.1+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl \
#     'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.6.1.post4/causal_conv1d-1.6.1%2Bcu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl'
#   curl -fL -o mamba_ssm-2.3.1+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl \
#     'https://github.com/state-spaces/mamba/releases/download/v2.3.1/mamba_ssm-2.3.1%2Bcu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl'
#   cd ../..
#
#   # 2) Build (build host needs internet access for fla install)
#   docker build -f Dockerfile.qwen35 -t qwen35-mbridge:cu129 .
#
# Run (each node):
#   docker run --rm -it --gpus all --shm-size=64g --ulimit memlock=-1 \
#     --network host \
#     -v /mnt/tidal-alsh01:/mnt/tidal-alsh01 \
#     qwen35-mbridge:cu129 bash
#
#   # Inside the container, on each node:
#   cd /mnt/tidal-alsh01/dataset/redone/hade/dd/Megatron-Bridge
#   bash scripts/install_runtime_deps.sh   # installs megatron-core + megatron-bridge editable
#   RANK=<N> MASTER_PORT=23456 bash /mnt/tidal-alsh01/dataset/redone/hade/dd/start.sh
# ==============================================================================

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.06-py3
FROM ${BASE_IMAGE}

# ------------------------------------------------------------------------------
# Build-time configuration
# ------------------------------------------------------------------------------
ARG UV_VERSION=0.9.18
ARG VENV_DIR=/opt/venv-mbridge
ARG FLA_VERSION=0.4.2

# ------------------------------------------------------------------------------
# Runtime environment
# ------------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    MBRIDGE_VENV_DIR=${VENV_DIR} \
    HF_HOME=/workspace/hf_cache \
    CUDA_DEVICE_MAX_CONNECTIONS=1 \
    NCCL_NVLS_ENABLE=0 \
    TORCH_NCCL_AVOID_RECORD_STREAMS=1 \
    MBRIDGE_DISABLE_CUDNN=0 \
    PATH=${VENV_DIR}/bin:${PATH}

# ------------------------------------------------------------------------------
# OS deps + timezone (Asia/Shanghai / UTC+8)
# tzdata is installed non-interactively; DEBIAN_FRONTEND=noninteractive is
# already set in the ENV block above so no debconf prompt appears.
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git git-lfs ninja-build cmake curl ca-certificates jq tmux less \
        tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# uv — package manager
# ------------------------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

# ------------------------------------------------------------------------------
# Create venv inheriting NGC's whole site-packages.
# Verify key NGC packages are present via file-presence checks only — no
# Python imports here because the build host has no GPU / CUDA driver, and
# importing torch / TE / flash-attn / APEX would fail on CUDA ext init.
# ------------------------------------------------------------------------------
RUN uv venv ${VENV_DIR} --python /usr/bin/python3.12 \
        --system-site-packages --seed && \
    SP_NGC=/usr/local/lib/python3.12/dist-packages; \
    for f in \
        torch/__init__.py \
        transformer_engine/__init__.py \
        flash_attn/__init__.py \
        apex/__init__.py \
    ; do \
        test -f "$SP_NGC/$f" \
            && echo "  ok (NGC)  $f" \
            || { echo "  FAIL (NGC)  $f — is base image correct?"; exit 1; }; \
    done

# ------------------------------------------------------------------------------
# Install causal-conv1d + mamba-ssm prebuilt wheels.
#
# NGC nv25.06 torch ABI is between stock 2.9 and 2.10, so no upstream
# mamba_ssm wheel loads cleanly (see memory.md §Mamba-SSM ABI Workaround).
# We use the cu12torch2.8 wheel and patch mamba_ssm/__init__.py below to make
# the failing selective_scan_cuda import non-fatal.
# The Qwen3.5-VL GDN path (mamba_ssm.ops.triton.ssd_combined) is pure
# Python + Triton + causal_conv1d and is unaffected.
#
# Wheel download (on build host before `docker build`):
#   mkdir -p docker/runtime_wheels && cd docker/runtime_wheels
#   curl -fL -o causal_conv1d-1.6.1+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl \
#     'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.6.1.post4/causal_conv1d-1.6.1%2Bcu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl'
#   curl -fL -o mamba_ssm-2.3.1+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl \
#     'https://github.com/state-spaces/mamba/releases/download/v2.3.1/mamba_ssm-2.3.1%2Bcu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl'
# ------------------------------------------------------------------------------
ARG WHEELS_DIR=docker/runtime_wheels
ARG CAUSAL_WHEEL=causal_conv1d-1.6.1+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl
ARG MAMBA_WHEEL=mamba_ssm-2.3.1+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl

COPY ${WHEELS_DIR}/${CAUSAL_WHEEL} /tmp/wheels/${CAUSAL_WHEEL}
COPY ${WHEELS_DIR}/${MAMBA_WHEEL}  /tmp/wheels/${MAMBA_WHEEL}

RUN ${VENV_DIR}/bin/pip install --no-cache-dir --no-deps \
        /tmp/wheels/${CAUSAL_WHEEL} \
        /tmp/wheels/${MAMBA_WHEEL} && \
    rm -rf /tmp/wheels

# Install flash-linear-attention (pure Python; fla-core ships the actual fla/ package).
# --no-deps: avoid pulling Triton/torch from PyPI (already in NGC image).
RUN ${VENV_DIR}/bin/pip install --no-cache-dir --no-deps \
        flash-linear-attention==${FLA_VERSION} && \
    ${VENV_DIR}/bin/pip install --no-cache-dir --no-deps \
        fla-core==${FLA_VERSION}

# ------------------------------------------------------------------------------
# Patch mamba_ssm/__init__.py — make selective_scan_cuda import non-fatal.
# See memory.md §Mamba-SSM ABI Workaround for full background.
# ------------------------------------------------------------------------------
RUN cat > ${VENV_DIR}/lib/python3.12/site-packages/mamba_ssm/__init__.py <<'PYEOF'
__version__ = "2.3.1"

# NGC nv25.06 patched torch 2.8 has an ABI between stock torch 2.9 and 2.10,
# so neither stock cu12torch2.8/2.9/2.10 prebuilt wheel matches:
#   - torch2.8/2.9 wheel:  undefined c10::cuda::SetDevice(int8_t, bool)
#   - torch2.10  wheel:    undefined c10::cuda::c10_cuda_check_implementation(..., bool)
# The `selective_scan_cuda` extension is only used by the legacy
# selective_scan_interface / Mamba1 / mamba_inner_fn paths. Megatron-Core's
# Qwen3.5-VL GDN path uses mamba_ssm.ops.triton.ssd_combined which is pure
# Python + Triton + causal_conv1d (the latter has a working wheel for our ABI).
# So we make the legacy CUDA imports best-effort: keep them if they load, but
# do not break `import mamba_ssm` if they don't.
#
# Catch BaseException, not just ImportError. The import chain reaches
# mamba_ssm.ops.triton.layer_norm whose module-level `@triton.autotune(...)`
# calls `driver.active.get_benchmarker()` which raises RuntimeError (not
# ImportError) on a no-GPU host. We need `import mamba_ssm` to be importable
# even on the build host (for find_spec / build sanity).
try:
    from mamba_ssm.ops.selective_scan_interface import selective_scan_fn, mamba_inner_fn  # noqa: F401
except BaseException as _e:
    selective_scan_fn = None
    mamba_inner_fn = None
    import warnings
    warnings.warn(
        "mamba_ssm.selective_scan_cuda failed to load "
        "(NGC torch ABI mismatch, or no-GPU build host); "
        "selective_scan_fn / mamba_inner_fn / Mamba1 will not work, but the "
        "Triton-based mamba_ssm.ops.triton.ssd_combined path used by "
        "megatron-core (Mamba2 / GDN) is unaffected. Original error: " + str(_e)
    )

try:
    from mamba_ssm.modules.mamba_simple import Mamba  # noqa: F401
except BaseException:
    Mamba = None

try:
    from mamba_ssm.modules.mamba2 import Mamba2  # noqa: F401
except BaseException:
    Mamba2 = None

try:
    from mamba_ssm.models.mixer_seq_simple import MambaLMHeadModel  # noqa: F401
except BaseException:
    MambaLMHeadModel = None
PYEOF

# ------------------------------------------------------------------------------
# Pre-bake stable pure-Python dependencies (and nvidia-resiliency-ext) into
# the venv at image build time.  This offloads the bulk of `uv sync` work from
# every container launch to a one-time image build step.
#
# Key design decisions (no-GPU build host safe):
#   - pip install, NOT uv sync: avoids needing pyproject.toml / uv.lock in the
#     image, so the image stays stable even as pyproject.toml evolves.
#   - --no-deps is NOT used: we want transitive deps resolved by pip here.
#   - Packages already in the NGC image (torch, TE, flash-attn, apex,
#     causal-conv1d, mamba-ssm, flash-linear-attention, fla-core, nvidia-cuda-*)
#     are absent from requirements-prebaked.txt; pip skips reinstalling them
#     because they satisfy the version constraints.
#   - nvidia-resiliency-ext comes from https://pypi.nvidia.com (NVIDIA PyPI).
#   - megatron-core and megatron-bridge are intentionally absent — they require
#     the /mnt NAS source tree and are installed at runtime by
#     scripts/install_runtime_deps.sh.
#   - Backward compatibility: install_runtime_deps.sh is unchanged in behavior.
#     `uv sync` detects pre-installed packages via the venv's site-packages and
#     skips re-downloading them, reducing runtime setup from ~10 min to ~1 min.
#
# To update: edit docker/requirements-prebaked.txt and rebuild the image.
# ------------------------------------------------------------------------------
COPY docker/requirements-prebaked.txt /tmp/requirements-prebaked.txt

RUN ${VENV_DIR}/bin/pip install --no-cache-dir \
        --extra-index-url https://pypi.nvidia.com \
        -r /tmp/requirements-prebaked.txt \
    && rm /tmp/requirements-prebaked.txt

# ------------------------------------------------------------------------------
# Build-time sanity — pure shell, no Python imports (no GPU on build host).
# See memory.md Pitfall #13.
# ------------------------------------------------------------------------------
RUN set -e; \
    SP=${VENV_DIR}/lib/python3.12/site-packages; \
    echo "=== Build-time sanity (file-presence only, no GPU required) ==="; \
    echo "--- baked-in wheels (causal-conv1d, mamba-ssm, fla) ---"; \
    for f in \
        causal_conv1d/__init__.py \
        mamba_ssm/__init__.py \
        mamba_ssm/ops/triton/ssd_combined.py \
        fla/__init__.py \
    ; do \
        test -f "$SP/$f" \
            && echo "  ok    $f" \
            || { echo "  FAIL  $f"; exit 1; }; \
    done; \
    grep -q "NGC nv25.06 patched torch" "$SP/mamba_ssm/__init__.py" \
        && echo "  ok    mamba_ssm ABI patch present" \
        || { echo "  FAIL  mamba_ssm patch missing"; exit 1; }; \
    echo "--- prebaked pure-Python deps (spot check) ---"; \
    for f in \
        transformers/__init__.py \
        peft/__init__.py \
        datasets/__init__.py \
        accelerate/__init__.py \
        diffusers/__init__.py \
        einops/__init__.py \
        omegaconf/__init__.py \
        tensorboard/__init__.py \
        wandb/__init__.py \
        hydra/__init__.py \
        timm/__init__.py \
        mlflow/__init__.py \
        nvidia_resiliency_ext/__init__.py \
        pytest/__init__.py \
        ruff/__main__.py \
    ; do \
        test -f "$SP/$f" \
            && echo "  ok    $f" \
            || { echo "  FAIL  $f"; exit 1; }; \
    done; \
    echo "=== sanity OK ==="

# ------------------------------------------------------------------------------
# Entrypoint: sets up PATH and execs the user command.
# No megatron-bridge logic here — source lives on /mnt, run from there.
# ------------------------------------------------------------------------------
COPY docker/entrypoint-mbridge.sh /usr/local/bin/entrypoint-mbridge.sh
RUN chmod +x /usr/local/bin/entrypoint-mbridge.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint-mbridge.sh"]
CMD ["bash"]

# syntax=docker/dockerfile:1.7
# ==============================================================================
# Dockerfile for Qwen3.5-122B-A10B SFT via megatron-bridge
# ------------------------------------------------------------------------------
# Base: NGC PyTorch 25.06-py3
#   CUDA 12.9.1 / PyTorch 2.8.0a0+nv25.06 / cuDNN 9.10.2 / TE 2.4 / NCCL /
#   APEX (with cuda ext) / flash-attn 2.7.4 — ALL inherited verbatim.
#
# We ONLY install what NGC does not ship:
#   - uv (package manager)
#   - megatron-core (3rdparty/Megatron-LM submodule, editable)
#   - megatron-bridge (this repo, editable)
#   - mamba-ssm + causal-conv1d (Megatron Mamba/GDN backend)
#   - flash-linear-attention (`fla`, GDN runtime)
#   - small Python deps tail from pyproject.toml
#
# Why NOT pin TE/torch/flash-attn/APEX:
#   NGC ships matched, GPU-tested, performance-tuned versions. Replacing them
#   either (a) downgrades performance, or (b) breaks ABI between TE-torch.
#
# Build:
#   cd /data/temp/Megatron-Bridge
#   docker build -f Dockerfile.qwen35 -t qwen35-mbridge:cu129 .
#
# Run (mount source + HF weights + workspace):
#   docker run --rm -it --gpus all --shm-size=64g --ulimit memlock=-1 \
#     --network host \
#     -v "$PWD":/workspace/Megatron-Bridge \
#     -v /path/to/hf/weights:/models:ro \
#     -v /path/to/runs:/workspace/runs \
#     qwen35-mbridge:cu129 bash
# ==============================================================================

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.06-py3
FROM ${BASE_IMAGE}

# ------------------------------------------------------------------------------
# Build-time configuration (override via --build-arg if needed)
# ------------------------------------------------------------------------------
ARG UV_VERSION=0.9.18
# Path inside image where the source is COPIED for fallback
ARG IMAGE_SRC_DIR=/opt/Megatron-Bridge
# Path the user is expected to mount source into; entrypoint prefers this
ARG MOUNT_SRC_DIR=/workspace/Megatron-Bridge
# venv path (independent from any /opt/venv that NGC may ship)
ARG VENV_DIR=/opt/venv-mbridge

# Pinned versions for the runtime-deferred packages (NGC does not ship them;
# entrypoint installs them on first launch via scripts/install_runtime_deps.sh).
# Override at `docker run -e MAMBA_SSM_VERSION=2.4.0` to upgrade without rebuild.
ARG MAMBA_SSM_VERSION=2.3.1
ARG CAUSAL_CONV1D_VERSION=1.6.1
ARG FLA_VERSION=0.4.2

# ------------------------------------------------------------------------------
# Runtime environment
# ------------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=${VENV_DIR} \
    HF_HOME=/workspace/hf_cache \
    CUDA_DEVICE_MAX_CONNECTIONS=1 \
    NCCL_NVLS_ENABLE=0 \
    TORCH_NCCL_AVOID_RECORD_STREAMS=1 \
    MBRIDGE_IMAGE_SRC_DIR=${IMAGE_SRC_DIR} \
    MBRIDGE_MOUNT_SRC_DIR=${MOUNT_SRC_DIR} \
    MBRIDGE_VENV_DIR=${VENV_DIR} \
    # NGC ships a healthy cuDNN 9; opt out of the bare-metal "disable cuDNN"
    # workaround. Override at `docker run -e MBRIDGE_DISABLE_CUDNN=1` if needed.
    MBRIDGE_DISABLE_CUDNN=0 \
    # Runtime-deferred dep versions (read by scripts/install_runtime_deps.sh)
    MAMBA_SSM_VERSION=${MAMBA_SSM_VERSION} \
    CAUSAL_CONV1D_VERSION=${CAUSAL_CONV1D_VERSION} \
    FLA_VERSION=${FLA_VERSION}

# ------------------------------------------------------------------------------
# OS deps that NGC may not ship explicitly
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git git-lfs ninja-build cmake curl ca-certificates jq tmux less \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# uv (Astral) — package manager. NGC 25.06 doesn't ship it.
# ------------------------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

# ------------------------------------------------------------------------------
# Copy megatron-bridge source as fallback (mount can override at runtime).
# .dockerignore controls what NOT to send.
# ------------------------------------------------------------------------------
WORKDIR ${IMAGE_SRC_DIR}
COPY . ${IMAGE_SRC_DIR}

# Verify the Megatron-Core submodule is populated. We require it to be init'd
# on the host BEFORE `docker build`, because:
#   - Docker COPY does not include .git/ by default, so `git submodule update`
#     inside the image would fail with "not a git repository".
#   - Even with .git present, the submodule URL points to GitHub which may not
#     be reachable from inside the image build network.
#
# `megatron/core/__init__.py` is the canonical existence check (the top-level
# `megatron/` is a PEP 420 namespace package with no __init__.py).
RUN cd ${IMAGE_SRC_DIR} && \
    if [ ! -f 3rdparty/Megatron-LM/megatron/core/__init__.py ]; then \
        echo "" ; \
        echo "ERROR: 3rdparty/Megatron-LM/megatron/core/__init__.py is missing." ; \
        echo "       The Megatron-Core submodule was NOT populated when the build" ; \
        echo "       context was sent to docker. On the host, run:" ; \
        echo "" ; \
        echo "         cd $(pwd | sed 's|/opt/Megatron-Bridge|/data/temp/Megatron-Bridge|')" ; \
        echo "         git submodule update --init --recursive" ; \
        echo "" ; \
        echo "       and then re-run docker build." ; \
        exit 1 ; \
    fi && \
    echo "submodule OK: $(ls 3rdparty/Megatron-LM/megatron | tr '\n' ' ')"

# ------------------------------------------------------------------------------
# Create venv inheriting NGC's whole site-packages (torch / TE / cuDNN /
# flash-attn / APEX / NCCL / cuBLAS / cuFFT / etc.).
# --system-site-packages: any module already system-installed is visible.
# --seed: include pip in the venv for ad-hoc installs.
# ------------------------------------------------------------------------------
RUN cd ${IMAGE_SRC_DIR} && \
    uv venv ${UV_PROJECT_ENVIRONMENT} --python /usr/bin/python3.12 \
        --system-site-packages --seed && \
    ${UV_PROJECT_ENVIRONMENT}/bin/python -c "import torch; print('inherited torch:', torch.__version__, 'cuda:', torch.version.cuda)" && \
    ${UV_PROJECT_ENVIRONMENT}/bin/python -c "import transformer_engine; print('inherited TE:', transformer_engine.__version__)" && \
    ${UV_PROJECT_ENVIRONMENT}/bin/python -c "import flash_attn; print('inherited flash-attn:', flash_attn.__version__)" && \
    ${UV_PROJECT_ENVIRONMENT}/bin/python -c "import fused_weight_gradient_mlp_cuda; print('inherited APEX cuda ext: OK')"

# ------------------------------------------------------------------------------
# uv sync: pull megatron-bridge dependencies, but skip everything NGC has.
# This installs:
#   - megatron-core (editable, from 3rdparty/Megatron-LM submodule)
#   - small Python deps: hydra, omegaconf, peft, jsonargparse, energon, ...
# It does NOT install: torch, TE, flash-attn, mamba-ssm, causal-conv1d,
# nvidia-cu1[23]-* — those are either NGC-provided or installed manually below.
# ------------------------------------------------------------------------------
RUN cd ${IMAGE_SRC_DIR} && \
    UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT} \
    uv sync --link-mode copy --all-extras --all-groups \
        --no-install-package torch \
        --no-install-package torchvision \
        --no-install-package triton \
        --no-install-package transformer-engine \
        --no-install-package transformer-engine-torch \
        --no-install-package transformer-engine-cu12 \
        --no-install-package flash-attn \
        --no-install-package mamba-ssm \
        --no-install-package causal-conv1d \
        --no-install-package nvidia-cublas \
        --no-install-package nvidia-cublas-cu12 \
        --no-install-package nvidia-cublas-cu13 \
        --no-install-package nvidia-cuda-cupti \
        --no-install-package nvidia-cuda-cupti-cu12 \
        --no-install-package nvidia-cuda-cupti-cu13 \
        --no-install-package nvidia-cuda-nvrtc \
        --no-install-package nvidia-cuda-nvrtc-cu12 \
        --no-install-package nvidia-cuda-nvrtc-cu13 \
        --no-install-package nvidia-cuda-runtime \
        --no-install-package nvidia-cuda-runtime-cu12 \
        --no-install-package nvidia-cuda-runtime-cu13 \
        --no-install-package nvidia-cudnn-cu12 \
        --no-install-package nvidia-cudnn-cu13 \
        --no-install-package nvidia-cufft \
        --no-install-package nvidia-cufft-cu12 \
        --no-install-package nvidia-cufft-cu13 \
        --no-install-package nvidia-cufile \
        --no-install-package nvidia-curand \
        --no-install-package nvidia-curand-cu12 \
        --no-install-package nvidia-curand-cu13 \
        --no-install-package nvidia-cusolver \
        --no-install-package nvidia-cusolver-cu12 \
        --no-install-package nvidia-cusolver-cu13 \
        --no-install-package nvidia-cusparse \
        --no-install-package nvidia-cusparse-cu12 \
        --no-install-package nvidia-cusparse-cu13 \
        --no-install-package nvidia-cusparselt-cu12 \
        --no-install-package nvidia-cusparselt-cu13 \
        --no-install-package nvidia-nccl-cu12 \
        --no-install-package nvidia-nccl-cu13 \
        --no-install-package nvidia-nvjitlink \
        --no-install-package nvidia-nvjitlink-cu12 \
        --no-install-package nvidia-nvjitlink-cu13 \
        --no-install-package nvidia-nvshmem-cu12 \
        --no-install-package nvidia-nvshmem-cu13 \
        --no-install-package nvidia-nvtx \
        --no-install-package nvidia-nvtx-cu12 \
        --no-install-package nvidia-nvtx-cu13 \
        --no-install-package cuda-toolkit \
        --no-install-package apex

# ------------------------------------------------------------------------------
# Install megatron-bridge as editable.
# At runtime, the entrypoint will re-`uv pip install -e` against the mount
# (if the user mounted /workspace/Megatron-Bridge), so live edits work.
#
# Note: `uv pip install` ignores UV_PROJECT_ENVIRONMENT (that's a `uv sync`-only
# variable). We pass --python explicitly to install into the venv.
# ------------------------------------------------------------------------------
RUN cd ${IMAGE_SRC_DIR} && \
    uv pip install --link-mode copy --python ${UV_PROJECT_ENVIRONMENT}/bin/python \
        --no-deps -e .

# ------------------------------------------------------------------------------
# NOTE: mamba-ssm / causal-conv1d / fla are deliberately NOT installed at
# build time. They:
#   - Compile with nvcc and need 5-15 min build time per image
#   - Touch CUDA driver at import; their build-time sanity would crash without
#     a GPU attached to `docker build`
#   - Add ~400MB to the image
#   - Are easy to (re)install at first container start (we have GPU then)
#
# Instead, the entrypoint runs `scripts/install_runtime_deps.sh` on first
# launch (idempotent, fast no-op once already installed). The user can also
# run that script manually or pre-bake into a derived image if desired.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Build-time sanity. Now that mamba_ssm / megatron.bridge are NOT in the image,
# we can do real imports for everything that IS installed without GPU.
# ------------------------------------------------------------------------------
RUN ${UV_PROJECT_ENVIRONMENT}/bin/python - <<'PYEOF'
import sys
import importlib

print("=" * 60)
print("Build-time sanity (no-GPU)")
print("=" * 60)

ok = True


def import_check(name: str, attr: str = "__version__", critical: bool = True) -> bool:
    global ok
    try:
        m = importlib.import_module(name)
        v = getattr(m, attr, "<no version>") if attr else "ok"
        print(f"  ok      {name:42s} {v}")
        return True
    except Exception as exc:
        label = "FAIL" if critical else "warn"
        print(f"  {label:6s}  {name:42s} {type(exc).__name__}: {exc}")
        if critical:
            ok = False
        return False


# --- NGC-provided libs (real import works without GPU) ---
print()
print("[NGC libs]")
import_check("torch")
import_check("transformer_engine")
import_check("transformer_engine.pytorch", attr=None)
import_check("flash_attn")
import_check("fused_weight_gradient_mlp_cuda", attr=None)  # APEX cuda ext
import_check("apex.normalization", attr=None, critical=False)

# --- megatron-core editable install: file existence (importing megatron.core
# eagerly imports submodules that may touch CUDA; verify presence only) ---
print()
print("[Project files]")
import importlib.util

for name in ("megatron", "megatron.core", "megatron.bridge",
             "megatron.bridge.models.qwen_vl.qwen35_vl_bridge",
             "megatron.bridge.recipes.qwen_vl"):
    spec = importlib.util.find_spec(name)
    if spec is None:
        print(f"  FAIL    {name:42s} (not installed)")
        ok = False
    else:
        origin = spec.origin or (spec.submodule_search_locations[0]
                                  if spec.submodule_search_locations else "<namespace>")
        print(f"  found   {name:42s} {origin}")

# --- Note on deferred deps ---
print()
print("[Deferred to runtime] (will be installed by entrypoint on first run)")
for name in ("mamba_ssm", "causal_conv1d", "fla"):
    spec = importlib.util.find_spec(name)
    status = "ALREADY INSTALLED" if spec else "deferred"
    print(f"  {status:18s}  {name}")

print()
print("=" * 60)
if not ok:
    print("FAIL: critical checks failed; image is NOT usable")
    sys.exit(1)
print("OK: build-time checks passed.")
print("    First `docker run` will install mamba-ssm/causal-conv1d/fla via")
print("    entrypoint; subsequent runs re-use them via /opt/venv-mbridge.")
print("    Run scripts/runtime_sanity.sh anytime to verify a live container.")
PYEOF

# ------------------------------------------------------------------------------
# Entrypoint that handles "mount overrides baked-in source" semantics
# ------------------------------------------------------------------------------
COPY docker/entrypoint-mbridge.sh /usr/local/bin/entrypoint-mbridge.sh
RUN chmod +x /usr/local/bin/entrypoint-mbridge.sh

# Make the venv the default Python environment
ENV PATH=${VENV_DIR}/bin:${PATH}

# Default working directory; user usually mounts source here
WORKDIR /workspace/Megatron-Bridge

ENTRYPOINT ["/usr/local/bin/entrypoint-mbridge.sh"]
CMD ["bash"]
